# Shared/service envs (copy to .env and fill)

## Supabase (required for scraper-runner)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

## EventBridge (optional locally; used in AWS)
EVENT_BUS_NAME=default

## Optional: disable EventBridge locally if AWS creds are expired/missing
# DISABLE_EVENTBRIDGE=1

## Optional: only persist rows that include at least one pdfUrls entry
# SCRAPER_REQUIRE_PDF=1

## Telegram (used by notifier lambdas, not by scraper-runner directly)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ERROR_CHAT_ID=

## Optional: tune scraper HTTP timeouts/retries (per-source)
# ROTA_TIMEOUT_MS=20000
# PLATAFORMA_TIMEOUT_MS=20000

## Optional: diagnostics / resilience for flaky DNS/network on Linux
# NODE_DNS_IPV4FIRST=1
# SCRAPER_FETCH_RETRIES=4
# SCRAPER_SOURCE_TIMEOUT_MS=300000
# SCRAPER_REPORT=1

## Optional: logging volume (defaults show a short sample per source)
# SCRAPER_LOG_QUIET=1
# SCRAPER_LOG_MAX_SAMPLES=5
# SCRAPER_LOG_MAX_TITULO=90
# SCRAPER_LOG_MAX_URL=140
# SCRAPER_LOG_MAX_PDF_URL=120

## document-processor (PDF → chunks → enrich → embed → documents)
# Obrigatório: mesmo Supabase acima. Ollama na mesma máquina ou URL interna.
# OLLAMA_BASE_URL=http://localhost:11434
# Chat: qwen2.5:7b precisa ~4.5+ GiB RAM; em máquinas com menos RAM use modelo menor:
# OLLAMA_CHAT_MODEL=llama3.2:3b
# (outras opções leves: phi3:mini, gemma2:2b). Para só PDF→embed sem LLM: ENRICH_CHUNKS=0
# OLLAMA_CHAT_MODEL=qwen2.5:7b
# OLLAMA_EMBED_MODEL=mxbai-embed-large:latest
# CHUNK_SIZE=800
# CHUNK_OVERLAP=200
# ENRICH_CHUNKS=1
# CHUNK_ENRICH_DELAY_MS=50
# EMBED_DIMENSIONS=768
# DISABLE_EVENTBRIDGE=1
#
# Performance / parallelism (local only; tune for your Ollama/Supabase capacity)
# DOCUMENT_PROCESSOR_CONCURRENCY=2
# ENRICH_CONCURRENCY=4
# EMBED_UPDATE_CONCURRENCY=8

## process-edital-service / validate-edital-service (Ollama /api/generate)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_TIMEOUT_MS=240000
# OLLAMA_MAX_CONTEXT_CHARS=22000

# process-edital-service
# PROCESS_EDITAL_LIMIT=0
# DELAY_BETWEEN_EDITAIS_MS=2000
# PROCESS_EDITAL_TOP_K=40

# validate-edital-service
# VALIDATE_EDITAIS_LIMIT=0
# VALIDATE_EDITAIS_BATCH=200
# API_REQUEST_DELAY_MS=3000
# DELAY_BETWEEN_EDITAIS_MS=6000
# VALIDATE_FORCE_REVALIDATE=0

