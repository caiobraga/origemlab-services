# Shared/service envs (copy to .env and fill)

## Supabase (required for scraper-runner)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

## EventBridge (optional locally; used in AWS)
EVENT_BUS_NAME=default

## Optional: disable EventBridge locally if AWS creds are expired/missing
# DISABLE_EVENTBRIDGE=1

## Optional: only persist rows that include at least one pdfUrls entry
# SCRAPER_REQUIRE_PDF=1

## Telegram (used by notifier lambdas, not by scraper-runner directly)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ERROR_CHAT_ID=

## Optional: tune scraper HTTP timeouts/retries (per-source)
# ROTA_TIMEOUT_MS=20000
# PLATAFORMA_TIMEOUT_MS=20000

## Optional: diagnostics / resilience for flaky DNS/network on Linux
# NODE_DNS_IPV4FIRST=1
# SCRAPER_FETCH_RETRIES=4
# Undici TCP connect default (~10s) is often too low from AWS Fargate → gov.br; raise if you see ConnectTimeoutError:
# SCRAPER_FETCH_CONNECT_TIMEOUT_MS=60000
# SCRAPER_FETCH_HEADERS_TIMEOUT_MS=120000
# SCRAPER_FETCH_BODY_TIMEOUT_MS=120000
# SCRAPER_SOURCE_TIMEOUT_MS=300000
# (fontes lentas ex. fapt: subir para 600000; JobFailed "Timeout after 300000ms")
# SCRAPER_REPORT=1

## Optional: logging volume (defaults show a short sample per source)
# SCRAPER_LOG_QUIET=1
# SCRAPER_LOG_MAX_SAMPLES=5
# SCRAPER_LOG_MAX_TITULO=90
# SCRAPER_LOG_MAX_URL=140
# SCRAPER_LOG_MAX_PDF_URL=120

## document-processor (PDF → chunks → enrich → embed → documents)
# Obrigatório: mesmo Supabase acima. Ollama na mesma máquina ou URL interna.
# OLLAMA_BASE_URL=http://localhost:11434
# Chat: qwen2.5:7b precisa ~4.5+ GiB RAM; em máquinas com menos RAM use modelo menor:
# OLLAMA_CHAT_MODEL=llama3.2:3b
# (outras opções leves: phi3:mini, gemma2:2b). Para só PDF→embed sem LLM: ENRICH_CHUNKS=0
# OLLAMA_CHAT_MODEL=qwen2.5:7b
# OLLAMA_EMBED_MODEL=mxbai-embed-large:latest
# CHUNK_SIZE=800
# CHUNK_OVERLAP=200
# ENRICH_CHUNKS=1
# CHUNK_ENRICH_DELAY_MS=50
# Coluna extra em documents (aplicar sql/20260513_documents_embedding_perguntas.sql):
# DOCUMENT_PROCESSOR_EMBED_PERGUNTAS=1
# (0 = não gera segundo vetor; top-k no process-edital usa só `embedding`)
# BACKFILL_PERGUNTAS_EMBED_BATCH=24
# EMBED_DIMENSIONS=768
# DISABLE_EVENTBRIDGE=1
#
# Performance / parallelism (local only; tune for your Ollama/Supabase capacity)
# DOCUMENT_PROCESSOR_CONCURRENCY=2
# ENRICH_CONCURRENCY=4
# EMBED_UPDATE_CONCURRENCY=8
#
# Simular worker contínuo da AWS (repete a fila após cada lote):
# ECS_WORKER_LOOP=1
# WORKER_IDLE_MS_AFTER_WORK=8000
# WORKER_IDLE_MS_NO_WORK=120000

## process-edital-service / validate-edital-service (Ollama /api/generate)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# Timeout por pedido ao Ollama (AbortController). "This operation was aborted" = aumentar isto ou OLLAMA_GENERATE_TIMEOUT_MS.
# OLLAMA_TIMEOUT_MS=600000
# Generate costuma precisar de mais tempo que embed (modelos grandes + janelas). No ECS o deploy envia 900000 por defeito.
# OLLAMA_GENERATE_TIMEOUT_MS=900000
# OLLAMA_EMBED_TIMEOUT_MS=180000
# Editais enormes (500k+ chars): janelas adaptativas — ver PROCESS_EDITAL_WINDOW_*_HUGE abaixo
# OLLAMA_MAX_CONTEXT_CHARS=22000

# EventBridge: após gravar cada edital (sucesso/warn/error). Local: DISABLE_EVENTBRIDGE=1
# EVENT_BUS_NAME=default
# OLLAMA_FETCH_RETRIES=3
# Retries em falhas de rede ao Ollama (fetch failed / ECONNREFUSED). Mensagens incluem error.cause.
# PROCESS_EDITAL_DOCUMENTS_PAGE_SIZE=200
# PROCESS_EDITAL_DOCUMENTS_MAX_CONTEXT=1200
# PROCESS_EDITAL_DOCUMENTS_MAX_TOPK=1200
# PROCESS_EDITAL_DOCUMENTS_MAX_WINDOWS=2500
# (evita statement timeout no Supabase — ver sql/20260516_documents_edital_lookup_indexes.sql)

# process-edital-service
# Aplicar no Supabase: sql/20260513_process_edital_editais_com_document_chunks.sql (RPC ordem por chunks em documents)
# PROCESS_EDITAL_LIMIT=0
# PROCESS_EDITAL_FETCH_PAGE_SIZE=1000
# PROCESS_EDITAL_ORDER=pending_first
# (pending_first = ordem RPC por volume de chunks, depois campos pendentes, depois criado_em desc;
#  documents_chunks_only = só RPC + criado_em; criado_em_desc = só ordem da query em editais)
# PROCESS_EDITAL_SKIP_CHUNK_ORDER_RPC=0
# (1 = não chama a RPC; útil se a função ainda não existir na base)
# PROCESS_EDITAL_TOPK_EMBEDDING=perguntas
# (perguntas = usa `embedding_perguntas` se existir, senão `embedding`; full = só `embedding`)
# PROCESS_EDITAL_ONLY_ID=
# (UUID único — processa só esse edital; útil para testar sem percorrer a fila toda)
# DELAY_BETWEEN_EDITAIS_MS=0
# PROCESS_EDITAL_CONCURRENCY=2
# PROCESS_EDITAL_FIELD_CONCURRENCY=2
# (paralelismo por task; subir só se Ollama aguentar — 3–4 editais × 2 campos ≈ 6–8 chamadas simultâneas)
# PROCESS_EDITAL_TOP_K=40
# PROCESS_EDITAL_TOP_K_PRAZO_INSCRICAO=60
# PROCESS_EDITAL_CONTEXT_PACK_ORDER=score
# (pack: score = preenche contexto por relevância até OLLAMA_MAX_CONTEXT_CHARS; reading = ordem chunk_index + truncar)
# Fallback por janelas (texto plano ordenado por chunk) quando top-k não retorna valor útil:
# PROCESS_EDITAL_WINDOW_CHARS=12000
# PROCESS_EDITAL_WINDOW_OVERLAP=2000
# PROCESS_EDITAL_WINDOW_MAX_WINDOWS=80
# plain >= 200k: janelas espalhadas; plain >= 400k: max 12 janelas de 10k chars
# PROCESS_EDITAL_WINDOW_MAX_PLAIN_BUILD=320000
# (não monta 800k+ chars — amostra início/fim/meio antes das janelas)
# PROCESS_EDITAL_WINDOW_LARGE_PLAIN_CHARS=200000
# PROCESS_EDITAL_WINDOW_HUGE_PLAIN_CHARS=400000
# PROCESS_EDITAL_WINDOW_MAX_WINDOWS_LARGE=20
# PROCESS_EDITAL_WINDOW_MAX_WINDOWS_HUGE=12
# PROCESS_EDITAL_WINDOW_CHARS_HUGE=10000
# PROCESS_EDITAL_EVIDENCE_SNIPPET_MAX=2800
# Coluna em editais: informacoes_extracao_evidence (jsonb) — aplicar sql/20260213_editais_informacoes_extracao_evidence.sql

# ingestion-pipeline-service (scraper + document-processor no mesmo container — recomendado no ECS)
# PIPELINE_SKIP_SCRAPER=0
# PIPELINE_SKIP_DOCUMENT_PROCESSOR=0
# SCRAPER_SOURCE=all
# INGESTION_PIPELINE_SCHEDULE_EXPRESSION=rate(1 hour)

# edital-pipeline-service (process + validate no mesmo container — recomendado no ECS)
# PIPELINE_SKIP_PROCESS=0
# PIPELINE_SKIP_VALIDATE=0
# ECS_ORCHESTRATION_MODE=scheduled   # no ECS: sem worker 24/7; EventBridge rate(1 hour) ou similar
# EDITAL_PIPELINE_SCHEDULE_EXPRESSION=rate(1 hour)   # variável GitHub no deploy

# validate-edital-service
# VALIDATE_EDITAIS_LIMIT=0
# VALIDATE_EDITAIS_BATCH=200
# API_REQUEST_DELAY_MS=0
# DELAY_BETWEEN_EDITAIS_MS=0
# VALIDATE_EDITAL_CONCURRENCY=2
# VALIDATE_FIELD_CONCURRENCY=2
# VALIDATE_FORCE_REVALIDATE=0
# Auditoria usa documento amplo (chunks com texto); limite de linhas em documents:
# VALIDATE_DOCUMENTS_LIMIT=3000
# Tamanho máximo do contexto enviado à auditoria (caracteres):
# VALIDATE_AUDIT_MAX_CONTEXT_CHARS=22000
# Segunda chamada Ollama para refinar redação dos campos string; desligar:
# VALIDATE_SKIP_POLISH=0

